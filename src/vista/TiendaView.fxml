<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.TiendaViewController">
    
    <children>
        <Label layoutX="20.0" layoutY="14.0" text="Productos" />
        <TableView fx:id="tablaProductos" layoutX="20.0" layoutY="38.0" prefHeight="310.0" prefWidth="360.0">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre" />
                <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                <TableColumn fx:id="colStock" prefWidth="95.0" text="Stock" />
            </columns>
        </TableView>

        <Label layoutX="398.0" layoutY="130.0" text="Cant:" />
        <TextField fx:id="txtCantidad" layoutX="435.0" layoutY="126.0" prefWidth="70.0" promptText="0" />
        <Button fx:id="btnAgregar" layoutX="435.0" layoutY="165.0" onAction="#agregarAlCarrito" text="Agregar" />

        <Label layoutX="530.0" layoutY="14.0" text="Carrito" />
        <ListView fx:id="listaCarrito" layoutX="530.0" layoutY="38.0" prefHeight="310.0" prefWidth="210.0" />

        <Button fx:id="btnConfirmar" layoutX="625.0" layoutY="362.0" onAction="#confirmarCompra" text="Confirmar compra" />
        <Label fx:id="lblMensaje" layoutX="20.0" layoutY="366.0" prefWidth="580.0" text="" />
    </children>
    
</AnchorPane>
